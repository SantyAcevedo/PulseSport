digraph G {graph [rankdir=LR,bgcolor="white",dpi=160];node [fontname="DejaVu Sans",fontsize=12,style=filled,fillcolor="#eef3f7",color="#607080"]; fan [shape=plaintext,label="Aficionado"]; subgraph cluster_app {label="PulseSport";fontname="DejaVu Sans"; scores [shape=ellipse,label="Consultar partidos"]; detail [shape=ellipse,label="Ver eventos del partido"]; fav [shape=ellipse,label="Guardar equipo favorito"]; alerts [shape=ellipse,label="Activar alertas"]; } fan->scores [dir=none];fan->detail [dir=none];fan->fav [dir=none];fan->alerts [dir=none];api [shape=box,label="Proveedor de datos"];scores->api [dir=none];detail->api [dir=none];alerts->api [dir=none];}